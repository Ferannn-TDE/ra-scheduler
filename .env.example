# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Supabase project URL (Project Settings > API), e.g. https://your-project.supabase.co
VITE_SUPABASE_URL=

# Supabase publishable / anon key (Project Settings > API). Safe for the browser; access is enforced by RLS.
VITE_SUPABASE_ANON_KEY=

# Google Gemini API key used by the class-timetable scanner (https://aistudio.google.com/apikey).
# This is bundled into the browser build, so restrict it by HTTP referrer and set a quota.
VITE_GEMINI_API_KEY=
